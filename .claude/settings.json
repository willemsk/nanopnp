{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(uv run pytest:*)",
      "Bash(uv run ruff:*)",
      "Bash(uv run mypy:*)",
      "Bash(uv sync:*)",
      "Bash(uv lock --check)",
      "Bash(uv run nanopnp --env)",
      "Bash(.claude/hooks/gate.sh run:*)",
      "Bash(uv run .claude/scripts/clause.py:*)",
      "Bash(uv run .claude/scripts/duplicates.py:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git fetch:*)",
      "Bash(git branch:*)"
    ],
    "deny": [
      "mcp__github__push_files",
      "mcp__github__create_or_update_file",
      "mcp__github__delete_file"
    ]
  },
  "enabledPlugins": {
    "bio-research@knowledge-work-plugins": false,
    "cowork-plugin-management@knowledge-work-plugins": false,
    "data@knowledge-work-plugins": false,
    "design@knowledge-work-plugins": false,
    "engineering@knowledge-work-plugins": false,
    "pdf-viewer@knowledge-work-plugins": false,
    "product-management@knowledge-work-plugins": false,
    "productivity@knowledge-work-plugins": false,
    "frontend-design@anthropic-plugin-directory": false,
    "github@anthropic-plugin-directory": false,
    "playwright@anthropic-plugin-directory": false,
    "supermatt@anthropic-plugin-directory": false
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-$(git rev-parse --show-toplevel)}/.claude/hooks/gate.sh\"",
            "timeout": 1800,
            "statusMessage": "Running the CLAUDE.md gate before committing..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-$(git rev-parse --show-toplevel)}/.claude/hooks/format.sh\"",
            "timeout": 60
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-$(git rev-parse --show-toplevel)}/.claude/hooks/session-start.sh\"",
            "timeout": 600,
            "statusMessage": "Syncing the uv environment..."
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-$(git rev-parse --show-toplevel)}/.claude/hooks/checkpoint.sh\"",
            "timeout": 30
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-$(git rev-parse --show-toplevel)}/.claude/hooks/checkpoint.sh\"",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-$(git rev-parse --show-toplevel)}/.claude/hooks/checkpoint.sh\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
