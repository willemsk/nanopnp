# Vendored third-party files are checked byte for byte against the npm tarball
# they came from (tests/tier1/test_gui_render.py), so no checkout may rewrite
# their line endings -- which a Windows checkout with core.autocrlf would.
src/nanopnp/gui/assets/webgui/** -text
third_party/** -text

# The shipped data files are identified by the sha256 of their bytes: a
# correction file's hash is its version and part of the stage-8 materials key
# (FR-25), and a reference geometry's hash names the delivered artefact. A
# Windows checkout with core.autocrlf would give the same file another hash.
data/** -text

# Vendored test structures are identified by the sha256 of their bytes: a
# structure file's digest enters the stage-1 artefact key (WP18 D11, D16).
tests/data/** -text
